{
  "capabilities": {
    "download": {
      "repo": "zinan92/content-downloader",
      "description": "统一内容下载 (抖音/小红书/公众号/X)",
      "stage": 2,
      "requires": ["python3"],
      "entry": "content-downloader download"
    },
    "extract": {
      "repo": "zinan92/content-extractor",
      "description": "多模态内容提取 (视频转录/图片OCR/文章清洗)",
      "stage": 3,
      "requires": ["python3", "whisper"],
      "entry": "content-extractor extract"
    },
    "rewrite": {
      "repo": "zinan92/content-rewriter",
      "description": "跨平台内容改写 (抖音→小红书/公众号)",
      "stage": 5,
      "requires": ["python3", "claude"],
      "entry": "content-rewriter rewrite"
    },
    "videocut": {
      "repo": "zinan92/videocut",
      "description": "视频编辑能力集 (剪口播/字幕/金句/拆条/封面/变速)",
      "stage": 6,
      "requires": ["node", "ffmpeg", "whisper", "claude"],
      "entry": "node cli.js",
      "subcommands": ["transcribe", "autocut", "subtitle", "hook", "clip", "cover", "speed", "pipeline"]
    },
    "analyze": {
      "repo": "zinan92/content-intelligence",
      "description": "内容分析与洞察 (趋势检测/爆款归因/选题建议)",
      "stage": 1,
      "requires": ["python3"],
      "entry": "python3 -m content_intelligence"
    },
    "publish": {
      "repo": "dreammis/social-auto-upload",
      "description": "多平台内容发布 (抖音/小红书/B站/快手/视频号/TikTok)",
      "stage": 7,
      "requires": ["python3", "patchright"],
      "entry": "sau"
    },
    "xiaohongshu": {
      "repo": "autoclaw-cc/xiaohongshu-skills",
      "description": "小红书站内操作 (登录/搜索/互动/图文视频发布)",
      "stage": 8,
      "requires": ["python3"],
      "entry": "python3 scripts/cli.py"
    }
  }
}
